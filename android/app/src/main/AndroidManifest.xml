<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Chỉ dùng cho Mẫu câu động (https://) do người dùng tạo — fetch lúc chạm. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dịch trên máy: "Chỉ tải qua Wi-Fi" kiểm tra mạng hiện tại trước khi tải gói ngôn ngữ. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Nút gõ giọng nói: thấy IME khác (vd Google voice typing) dưới package visibility. -->
    <queries>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.VietTelex"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:supportsRtl="false">
        <!-- Perfetto/Macrobenchmark đọc được mốc "VT.*" trên bản release (API 29+), không cần debuggable. -->
        <profileable android:shell="true" tools:targetApi="29" />
        <!-- ML Kit (Dịch trên máy): không tự khởi tạo lúc mở process (bàn phím chạy ở process này) —
             MlKitBackend khởi tạo khi chạm "Dịch" / mở trang cài đặt dịch. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />
        <!-- App cài đặt (Compose) chạy process riêng ":settings" — không để ~15 MB Compose/HWUI nằm
             lại mãi trong process bàn phím (RAM-AUDIT #5). Prefs đồng bộ qua shared/PrefSync. -->
        <activity
            android:name=".ui.MainActivity"
            android:process=":settings"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Bubble ⚙️ trên bàn phím mở thẳng tab Mẫu Câu -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="viettelex" android:host="maucau" />
            </intent-filter>
            <!-- Chia sẻ chữ từ app khác ⇒ thêm vào Mẫu câu (không cần mạng) -->
            <intent-filter android:label="@string/share_to_templates">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Luyện vuốt: chia sẻ file JSON nét vuốt vừa xuất (cache/export) qua share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:process=":settings"
            android:authorities="${applicationId}.export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/export_paths" />
        </provider>
        <!-- Activity của thư viện chỉ được mở từ app cài đặt (Play Billing, hộp thoại Play Core /
             Google Play services) ⇒ cùng process ":settings", không kéo vào process bàn phím. -->
        <activity android:name="com.android.billingclient.api.ProxyBillingActivity"
            android:process=":settings" tools:node="merge" />
        <activity android:name="com.android.billingclient.api.ProxyBillingActivityV2"
            android:process=":settings" tools:node="merge" />
        <activity android:name="com.google.android.play.core.common.PlayCoreDialogWrapperActivity"
            android:process=":settings" tools:node="merge" />
        <activity android:name="com.google.android.gms.common.api.GoogleApiActivity"
            android:process=":settings" tools:node="merge" />
        <!-- androidx.startup (emoji2, ProcessLifecycleOwner, ProfileInstaller) chỉ chạy ở process
             cài đặt: process chính là process BÀN PHÍM — mở lạnh không nạp provider + 3 initializer
             trước IME.onCreate (docs/PERF-IME-SHOW.md). Bàn phím không dùng EmojiCompat/lifecycle. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:process=":settings"
            android:exported="false"
            tools:node="merge" />
        <service
            android:name=".ime.VietTelexIME"
            android:label="@string/ime_name"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
