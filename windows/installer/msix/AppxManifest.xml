<?xml version="1.0" encoding="utf-8"?>
<!--
  OPTIONAL / COMPANION-ONLY — NOT the Store submission path.

  VietTelex is submitted to the Microsoft Store as an "MSI or EXE app" (see
  installer/STORE.md). An MSIX package cannot register a system-wide TSF text service
  (package registry writes are virtualized; TSF loads TIPs from the real HKLM keys into
  every process), so this manifest could only ever carry VietTelex.exe without the
  keyboard. Kept as a template in case packaged third-party TIPs become possible.

  Placeholders: __IDENTITY_NAME__ __PUBLISHER__ __PUBLISHER_DISPLAY__ __VERSION__ __ARCH__
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap desktop rescap">
  <Identity Name="__IDENTITY_NAME__" Publisher="__PUBLISHER__" Version="__VERSION__"
            ProcessorArchitecture="__ARCH__" />
  <Properties>
    <DisplayName>VietTelex</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Bộ gõ tiếng Việt tối giản, nhanh, ổn định. Không thu thập dữ liệu.</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="vi-VN" />
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="VietTelex" Executable="VietTelex.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="VietTelex" Description="Bộ gõ tiếng Việt"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="VietTelex.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="VietTelexTray" Enabled="true" DisplayName="VietTelex" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
