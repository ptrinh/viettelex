<?xml version="1.0" encoding="UTF-8"?>
<!--
  VietTelex — per-machine MSI (WiX v4/v5).

  One MSI per native architecture:
    Platform=x64    VietTelexTIP.dll (x64) + VietTelexTIP.dll (x86, for 32-bit apps)
    Platform=arm64  VietTelexTIP.dll (ARM64X = ARM64 + ARM64EC, so native AND emulated
                    x64 apps load the same registered DLL) + x86 DLL
  Build (installer/build.ps1 does all of this):
    wix build VietTelex.wxs -arch x64 -d Version=0.1.0.1 -d Platform=x64
              -d BinNative=..\..\build-x64\Release -d BinX86=..\..\build-x86\Release
              -o VietTelex-0.1.0.1-x64.msi
  Registration:
    * COM + TSF profile + categories: DllRegisterServer via regsvr32 (deferred, SYSTEM).
    * Per user (keyboard in the language list, autostart): VietTelex.exe with the setup-user switch,
      run impersonated after install; other users get it on their first app launch.
    * Uninstall: VietTelex.exe with the cleanup-user switch (impersonated), then regsvr32 /u.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef Version ?><?define Version = "0.1.0.1" ?><?endif?>
  <?ifndef Platform ?><?define Platform = "x64" ?><?endif?>
  <?ifndef BinNative ?><?define BinNative = "..\..\build-$(var.Platform)\Release" ?><?endif?>
  <?ifndef BinX86 ?><?define BinX86 = "..\..\build-x86\Release" ?><?endif?>

  <Package Name="VietTelex" Manufacturer="VietTelex" Version="$(var.Version)"
           UpgradeCode="C7AF803E-D7DC-4371-9318-04EA3B66BF59" Scope="perMachine" Compressed="yes"
           Language="1066" Codepage="65001">
    <SummaryInformation Description="VietTelex — bộ gõ tiếng Việt" Codepage="65001" />
    <MajorUpgrade DowngradeErrorMessage="Đã cài phiên bản VietTelex mới hơn. / A newer VietTelex is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="VietTelexIcon" SourceFile="..\..\ime\res\viettelex.ico" />
    <Property Id="ARPPRODUCTICON" Value="VietTelexIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://viettelex.com" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ptrinh/viettelex/issues" />
    <!-- Windows 10 1903 (build 18362) or later. -->
    <Launch Condition="Installed OR (VersionNT >= 603 AND WindowsBuild >= 18362)"
            Message="VietTelex cần Windows 10 1903 trở lên. / VietTelex needs Windows 10 1903 or later." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="VietTelex" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER86" Name="VietTelex" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- AppContainer processes (Store apps, Start, Search) must be able to load the TIP. -->
    <?define TipSddl = "D:PAI(A;;FA;;;SY)(A;;FA;;;BA)(A;;GRGX;;;BU)(A;;GRGX;;;S-1-15-2-1)(A;;GRGX;;;S-1-15-2-2)" ?>

    <ComponentGroup Id="Native" Directory="INSTALLFOLDER" Bitness="always64">
      <Component Id="AppExe">
        <File Id="VietTelexExe" Source="$(var.BinNative)\VietTelex.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="VietTelex"
                    Description="VietTelex — bộ gõ tiếng Việt" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
                    Icon="VietTelexIcon" />
        </File>
        <RegistryValue Root="HKLM" Key="SOFTWARE\VietTelex" Name="AppPath" Type="string"
                       Value="[INSTALLFOLDER]VietTelex.exe" />
      </Component>
      <Component Id="TipNative">
        <File Id="TipNativeDll" Source="$(var.BinNative)\VietTelexTIP.dll" KeyPath="yes">
          <PermissionEx Sddl="$(var.TipSddl)" />
        </File>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="X86" Directory="INSTALLFOLDER86" Bitness="always32">
      <Component Id="TipX86">
        <File Id="TipX86Dll" Source="$(var.BinX86)\VietTelexTIP.dll" KeyPath="yes">
          <PermissionEx Sddl="$(var.TipSddl)" />
        </File>
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="VietTelex" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="Native" />
      <ComponentGroupRef Id="X86" />
    </Feature>

    <!-- regsvr32 of each architecture (System64Folder = native, SystemFolder = SysWOW64). -->
    <CustomAction Id="RegisterTipNative" Directory="System64Folder" Execute="deferred" Impersonate="no"
                  Return="check" ExeCommand="regsvr32.exe /s &quot;[INSTALLFOLDER]VietTelexTIP.dll&quot;" />
    <CustomAction Id="RegisterTipX86" Directory="SystemFolder" Execute="deferred" Impersonate="no"
                  Return="check" ExeCommand="regsvr32.exe /s &quot;[INSTALLFOLDER86]VietTelexTIP.dll&quot;" />
    <CustomAction Id="UnregisterTipNative" Directory="System64Folder" Execute="deferred" Impersonate="no"
                  Return="ignore" ExeCommand="regsvr32.exe /u /s &quot;[INSTALLFOLDER]VietTelexTIP.dll&quot;" />
    <CustomAction Id="UnregisterTipX86" Directory="SystemFolder" Execute="deferred" Impersonate="no"
                  Return="ignore" ExeCommand="regsvr32.exe /u /s &quot;[INSTALLFOLDER86]VietTelexTIP.dll&quot;" />
    <!-- Per-user steps run as the installing user (not SYSTEM). -->
    <CustomAction Id="SetupUser" FileRef="VietTelexExe" ExeCommand="--setup-user" Execute="immediate"
                  Return="ignore" />
    <CustomAction Id="CleanupUser" FileRef="VietTelexExe" ExeCommand="--cleanup-user" Execute="deferred"
                  Impersonate="yes" Return="ignore" />
    <CustomAction Id="LaunchApp" FileRef="VietTelexExe" ExeCommand="--background" Execute="immediate"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="CleanupUser" Before="UnregisterTipNative"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="UnregisterTipNative" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="UnregisterTipX86" After="UnregisterTipNative" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RegisterTipNative" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="RegisterTipX86" After="RegisterTipNative" Condition="NOT REMOVE" />
      <Custom Action="SetupUser" After="InstallFinalize" Condition="NOT REMOVE" />
      <Custom Action="LaunchApp" After="SetupUser" Condition="NOT REMOVE AND UILevel >= 4" />
    </InstallExecuteSequence>
  </Package>
</Wix>
