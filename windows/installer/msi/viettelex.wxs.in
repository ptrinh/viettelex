<?xml version="1.0" encoding="UTF-8"?>
<!--
  VietTelex MSI template for wixl (msitools), filled by windows/scripts/release.sh. It
  uses WiX v3 syntax and stays inside the subset wixl implements.

  Per-machine install:
    %ProgramFiles%\VietTelex\        VietTelex.exe, VietTelexTIP_<ver>.dll (native)
                                     arm64 only: VietTelexTIP_<ver>.dll is the ARM64X
                                     forwarder, plus VietTelexTIP_{arm64,x64}_<ver>.dll
    %ProgramFiles(x86)%\VietTelex\   VietTelexTIP_<ver>.dll (x86, for 32-bit apps)
  The TIP DLL names carry the version (e.g. _1_0_6): the TIP is loaded into other running
  apps and cannot be closed, so an upgrade installs NEW files next to the loaded ones
  (ReleaseTip moves the old ones aside first) — no "files in use", no reboot prompt.
  Start menu shortcut and an Add/Remove Programs entry.

  NO regsvr32. The COM + TSF registration is RegistryValue elements spliced in at the
  REG_* markers by release.sh, generated from ime/core/registration.h (the data
  DllRegisterServer uses): TipNative writes the 64-bit view, TipX86 the 32-bit view.
  They must be written BY WIXL: rows inserted afterwards with msibuild's SQL land out of
  primary-key order and Windows fails at FileCost with error 2211 (1.0.0).

  Every PE file carries DefaultVersion (= the release, x.y.z.0) and Language 1033. Without
  a File.Version the MSI treats the new file as UNVERSIONED, and Windows Installer never
  replaces an installed versioned file with an unversioned one: 1.0.8/1.0.9 left the 1.0.7
  VietTelex.exe in place. check_msi.py enforces it.

  Placeholders (at-sign delimited) must all be filled or the build fails.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="@PRODUCTCODE@" Name="VietTelex" Language="1033" Version="@VERSION@"
           Manufacturer="VietTelex" UpgradeCode="@UPGRADECODE@">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="VietTelex @VERSION@ installer" Manufacturer="VietTelex" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of VietTelex is already installed." />
    <Media Id="1" Cabinet="viettelex.cab" EmbedCab="yes" />
    <Icon Id="viettelex.ico" SourceFile="@ICON@" />
    <Property Id="ARPPRODUCTICON" Value="viettelex.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://viettelex.com" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ptrinh/viettelex/issues" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- Restart Manager off: it would offer to close EVERY app that has the TIP loaded
         (all apps with a text field). QuitApp closes VietTelex.exe itself instead, and the
         version-named TIP files never collide with loaded ones. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <!-- Never prompt for a reboot: a TIP DLL still mapped by running apps is renamed and
         deleted at the next boot silently; nothing else needs one. -->
    <Property Id="REBOOT" Value="ReallySuppress" />
    <!-- MSI-only helper (not installed): runs before any file of this package exists. -->
    <Binary Id="SetupHelper" SourceFile="@BIN_NATIVE@/VietTelexSetupHelper.exe" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="VietTelex">
          <Component Id="AppExe" Guid="@GUID_APP@" Win64="yes">
            <File Id="VietTelexExe" Name="VietTelex.exe" Source="@BIN_NATIVE@/VietTelex.exe" KeyPath="yes" DefaultVersion="@FILEVERSION@" DefaultLanguage="1033" />
            <!-- The TIP's language-bar menu finds the app through this (64-bit view). -->
            <RegistryValue Root="HKLM" Key="SOFTWARE\VietTelex" Name="AppPath" Type="string"
                           Value="[INSTALLFOLDER]VietTelex.exe" />
          </Component>
          <!-- Component rules for the LATE RemoveExistingProducts (after InstallExecute):
               the old version is removed after this one is installed, and only resources
               of components this package does NOT share with it get deleted. So
                 * version-named files get a per-VERSION component GUID (TipNative, TipX86,
                   the ARM64 halves): a new name is a new component;
                 * the COM/TSF registration lives in registry-only components whose GUIDs
                   are the ones <= 1.0.5 used for TipNative/TipX86 (TipReg, TipReg86):
                   shared, so removing the old version keeps the keys the new one wrote. -->
          <Component Id="TipNative" Guid="@GUID_TIPFILE@" Win64="yes">
            <File Id="TipNativeDll" Name="@TIPDLL@" Source="@BIN_NATIVE@/@TIPDLL@" KeyPath="yes" DefaultVersion="@FILEVERSION@" DefaultLanguage="1033" />
          </Component>
          <Component Id="TipReg" Guid="@GUID_TIPNATIVE@" Win64="yes">
            <!-- @REG_TIPNATIVE@ -->
          </Component>
          <!-- @ARM64_COMPONENTS@ -->
        </Directory>
      </Directory>
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER86" Name="VietTelex">
          <Component Id="TipX86" Guid="@GUID_TIPFILE86@" Win64="no">
            <File Id="TipX86Dll" Name="@TIPDLL@" Source="@BIN_X86@/@TIPDLL@" KeyPath="yes" DefaultVersion="@FILEVERSION@" DefaultLanguage="1033" />
          </Component>
          <Component Id="TipReg86" Guid="@GUID_TIPX86@" Win64="no">
            <!-- @REG_TIPX86@ -->
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcut" Guid="@GUID_SHORTCUT@">
          <Shortcut Id="StartMenuLaunch" Name="VietTelex" Description="VietTelex - Vietnamese input"
                    Target="[INSTALLFOLDER]VietTelex.exe" WorkingDirectory="INSTALLFOLDER" Icon="viettelex.ico" />
          <RegistryValue Root="HKCU" Key="Software\VietTelex" Name="startMenuShortcut"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <!-- Per-user steps (keyboard in the user's language list, autostart) and clean removal.
         NOT FileKey (type 18): a FileKey custom action fails with error 2753 "file not
         marked for installation" whenever the exe's component has no action in that run —
         repair, REINSTALL of a same-version file, maintenance (1.0.4). wixl also silently
         drops Directory+ExeCommand (type 34), so: SetVtxExe (type 51) puts the installed
         path in VTXEXE after CostFinalize, and the three actions are type 50 ("exe named by
         a property"), which never looks at file install state.
           SetupUser   immediate, after InstallFinalize -> runs as the installing user;
                       any run that leaves the product installed (install, upgrade, repair).
           LaunchApp   opens the Settings window after an INTERACTIVE install/upgrade only
                       (UILevel >= 4: never for /qn or Store installs, never on repair
                       (REINSTALL) or removal), fire-and-forget.
           CleanupUser deferred + impersonated (as the user), before RemoveFiles, only on a
                       real uninstall (not the removal half of a major upgrade). -->
    <CustomAction Id="SetVtxExe" Property="VTXEXE" Value="[INSTALLFOLDER]VietTelex.exe" />
    <!-- QuitApp / ReleaseTip run SetupHelper from the Binary table (type 2). wixl cannot
         author BinaryKey+ExeCommand, so they are written here as property actions and
         re-pointed at the Binary row by release.sh (UPDATE of non-key columns only).
           QuitApp    immediate, as the user, before InstallValidate: WM_CLOSE to every
                      VietTelex.exe, wait 3 s, terminate only VietTelex.exe images.
           ReleaseTip deferred as SYSTEM, before RemoveFiles/InstallFiles (so only
                      the OLD files exist): move in-use VietTelexTIP*.dll aside (deleted at
                      next boot, silently). The old product's removal (late REP) then
                      finds nothing in use; neither does an uninstall. Two guards keep an OLD
                      package (removed by a newer one) off the NEWER files: the condition
                      NOT UPGRADINGPRODUCTCODE, and max-version (only DLLs of this version or
                      older are moved — needed where UPGRADINGPRODUCTCODE is not set).
                      Paths end in "\." — a bare trailing backslash would escape the
                      closing quote in the helper's command line. -->
    <CustomAction Id="QuitApp" Property="VTXHELPER" ExeCommand="--quit-app"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="ReleaseTip" Property="VTXHELPER"
                  ExeCommand="--max-version @VERSION@ --release-tip &quot;[INSTALLFOLDER].&quot; &quot;[INSTALLFOLDER86].&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="SetupUser" Property="VTXEXE" ExeCommand="--setup-user"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="LaunchApp" Property="VTXEXE" ExeCommand="--settings"
                  Execute="immediate" Return="asyncNoWait" />
    <CustomAction Id="CleanupUser" Property="VTXEXE" ExeCommand="--cleanup-user"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <!-- EXPLICIT sequence numbers: wixl does not honour Before/After reliably (1.0.3 put
         CleanupUser at 1, before costing, and uninstall failed with error 2731).
         Standard numbers: CostFinalize 1000, InstallValidate 1400, InstallInitialize 1500,
         RemoveShortcuts 3200, RemoveFiles 3500, InstallFiles 4000, InstallFinalize 6600. check_msi.py enforces the ordering. -->
    <InstallExecuteSequence>
      <Custom Action="SetVtxExe" Sequence="1010" />
      <Custom Action="QuitApp" Sequence="1020" />
      <Custom Action="CleanupUser" Sequence="3400">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <!-- NOT UPGRADINGPRODUCTCODE: when THIS package is the old version being removed by
           a newer one (late REP, after the newer files are installed), it must not move
           the newer version's DLLs aside. -->
      <Custom Action="ReleaseTip" Sequence="3450">NOT UPGRADINGPRODUCTCODE</Custom>
      <!-- RemoveExistingProducts may only sit where Windows Installer allows (ICE63;
           1.0.6 broke this and failed with error 2613): here, between InstallExecute
           and InstallFinalize — the old version is removed after the new one is fully
           in place. check_msi.py encodes the allowed positions. -->
      <InstallExecute Sequence="6590" />
      <RemoveExistingProducts Sequence="6595" />
      <Custom Action="SetupUser" Sequence="6610">NOT REMOVE</Custom>
      <Custom Action="LaunchApp" Sequence="6620">NOT REMOVE AND NOT REINSTALL AND UILevel &gt;= 4</Custom>
    </InstallExecuteSequence>

    <Feature Id="Complete" Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="TipNative" />
      <ComponentRef Id="TipReg" />
      <!-- @ARM64_REFS@ -->
      <ComponentRef Id="TipX86" />
      <ComponentRef Id="TipReg86" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
