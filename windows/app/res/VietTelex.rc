// VietTelex.rc — icon, manifest, version info for VietTelex.exe.
#include <winver.h>
#include <winuser.h>

#include "../../ime/version.h"

#include "../../ime/res/icon_ids.h"

IDI_APP ICON "../../ime/res/viettelex.ico"
// Tray / input-indicator glyphs from the macOS menu-bar icons (make_icons.py).
IDI_GLYPH_VT_V_DARK ICON "../../ime/res/glyph_vt_v_dark.ico"
IDI_GLYPH_VT_V_LIGHT ICON "../../ime/res/glyph_vt_v_light.ico"
IDI_GLYPH_VT_E_DARK ICON "../../ime/res/glyph_vt_e_dark.ico"
IDI_GLYPH_VT_E_LIGHT ICON "../../ime/res/glyph_vt_e_light.ico"
IDI_GLYPH_STAR_V_DARK ICON "../../ime/res/glyph_star_v_dark.ico"
IDI_GLYPH_STAR_V_LIGHT ICON "../../ime/res/glyph_star_v_light.ico"
IDI_GLYPH_STAR_E_DARK ICON "../../ime/res/glyph_star_e_dark.ico"
IDI_GLYPH_STAR_E_LIGHT ICON "../../ime/res/glyph_star_e_light.ico"
IDI_GLYPH_FLAG_V_DARK ICON "../../ime/res/glyph_flag_v_dark.ico"
IDI_GLYPH_FLAG_V_LIGHT ICON "../../ime/res/glyph_flag_v_light.ico"
IDI_GLYPH_FLAG_E_DARK ICON "../../ime/res/glyph_flag_e_dark.ico"
IDI_GLYPH_FLAG_E_LIGHT ICON "../../ime/res/glyph_flag_e_light.ico"
// Keyboard-profile icons (the taskbar/Win+Space icon), for the Settings picker preview.
IDI_PROFILE_VT ICON "../../ime/res/profile_vt.ico"
IDI_PROFILE_STAR ICON "../../ime/res/profile_star.ico"
IDI_PROFILE_FLAG ICON "../../ime/res/profile_flag.ico"
IDI_PROFILE_LOGO ICON "../../ime/res/profile_logo.ico"
IDI_PROFILE_VI ICON "../../ime/res/profile_vi.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "VietTelex.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VTX_VER_MAJOR,VTX_VER_MINOR,VTX_VER_PATCH,VTX_VER_BUILD
 PRODUCTVERSION VTX_VER_MAJOR,VTX_VER_MINOR,VTX_VER_PATCH,VTX_VER_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "042a04b0"
        BEGIN
            VALUE "CompanyName", "VietTelex"
            VALUE "FileDescription", "VietTelex"
            VALUE "FileVersion", VTX_VER_STRING
            VALUE "InternalName", "VietTelex"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "VietTelex.exe"
            VALUE "ProductName", "VietTelex"
            VALUE "ProductVersion", VTX_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x042a, 1200
    END
END
