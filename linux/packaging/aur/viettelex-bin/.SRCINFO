	depends = python-gobject
	depends = gtk4
	depends = libadwaita
	depends = hicolor-icon-theme
	optdepends = fcitx5-configtool: add "Vietnamese (VietTelex)" from a GUI (Fcitx5)
	optdepends = fcitx5-gtk: Fcitx5 in GTK applications
	optdepends = fcitx5-qt: Fcitx5 in Qt applications
	optdepends = ibus: use the IBus engine instead of Fcitx5 (default on GNOME)
