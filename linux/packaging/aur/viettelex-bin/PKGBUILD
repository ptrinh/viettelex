# there, not the version/checksums here.

pkgname=viettelex-bin
pkgver=1.0.8
pkgrel=1
_series=noble
pkgdesc='Vietnamese input method (Telex, VNI) for Fcitx5 and IBus, same engine as VietTelex for macOS'
arch=('x86_64' 'aarch64')
url='https://viettelex.com'
license=('MIT')
depends=(
  'glibc'
  'gcc-libs'
  'glib2'
  'fcitx5'
  'libibus'
  'python'
  'python-gobject'
  'gtk4'
  'libadwaita'
  'hicolor-icon-theme'
)
optdepends=(
  'fcitx5-configtool: add "Vietnamese (VietTelex)" from a GUI (Fcitx5)'
  'fcitx5-gtk: Fcitx5 in GTK applications'
  'fcitx5-qt: Fcitx5 in Qt applications'
  'ibus: use the IBus engine instead of Fcitx5 (default on GNOME)'
)
provides=('viettelex')
conflicts=('viettelex')
options=('!strip' '!debug')
install=viettelex.install
_gh="https://github.com/ptrinh/viettelex/releases/download/linux-v${pkgver}"
source=("${_gh}/viettelex-settings_${pkgver}.${_series}1_all.deb")
source_x86_64=(
  "${_gh}/libviettelex-core_${pkgver}.${_series}1_amd64.deb"
  "${_gh}/viettelex-fcitx5_${pkgver}.${_series}1_amd64.deb"
  "${_gh}/viettelex-ibus_${pkgver}.${_series}1_amd64.deb"
  "${_gh}/viettelex-text-tools_${pkgver}.${_series}1_amd64.deb"
)
source_aarch64=(
  "${_gh}/libviettelex-core_${pkgver}.${_series}1_arm64.deb"
  "${_gh}/viettelex-fcitx5_${pkgver}.${_series}1_arm64.deb"
  "${_gh}/viettelex-ibus_${pkgver}.${_series}1_arm64.deb"
  "${_gh}/viettelex-text-tools_${pkgver}.${_series}1_arm64.deb"
)
noextract=("${source[@]##*/}" "${source_x86_64[@]##*/}" "${source_aarch64[@]##*/}")
sha256sums=('6f247437543b5e0f934f50889a38eaf210e043c53864154c6f0e47f1c0cbe72c')
sha256sums_x86_64=('9983d4d7697dc04b618b0c943f0b9466d9fa501d858e558000dcac372d51e75d' '8003882765c10457edebf8d27c8612c57fe78ce99b3f3ca70d49d1d0f480b115' '8bc3b42e937ac44de5df7d1ff2638ab936de930addf7521100ea4d8e977abd52' 'f74534df4414cbd46cef60982b29b91ef495e02d8f1bd3d3012315581df0f2c4')
sha256sums_aarch64=('69bb463b1074775a52a5bc0f96aaa5f0af186072c80cd9e301eb8b90f0897e3c' 'fee617d2f5d48799d8ec12c4ecd04fcf3f12f7adc939ccfdc5b5dcf33104ef0e' '64441a323ba4d7ae7de224c913d63c85ba8a3f38f78f68058c1da84ff90a1601' 'a622eef71655c9d0e87e849f2e90334742adf65c047432aecda65fe939aeb3de')

package() {
  local deb
  for deb in "${srcdir}"/*.deb; do
    bsdtar -xOf "${deb}" 'data.tar.*' | bsdtar -xpf - -C "${pkgdir}"
  done
  cd "${pkgdir}"

  # The engine (libtelexcore), viettelex-text-tool and the frontends' RPATH are compiled
  # for the Debian multiarch directory, so it stays as VietTelex's private directory.
  local triplet
  case "${CARCH}" in
    x86_64) triplet=x86_64-linux-gnu ;;
    aarch64) triplet=aarch64-linux-gnu ;;
  esac
  test -f "usr/lib/${triplet}/viettelex/libtelexcore.so"

  # Fcitx5 on Arch loads addons from /usr/lib/fcitx5.
  install -d usr/lib/fcitx5
  mv "usr/lib/${triplet}/fcitx5/viettelex.so" usr/lib/fcitx5/
  rmdir "usr/lib/${triplet}/fcitx5"

  # IBus engine: Arch has no /usr/libexec → /usr/lib/ibus, and point the component there.
  install -d usr/lib/ibus
  mv usr/libexec/ibus-engine-viettelex usr/lib/ibus/
  sed -i 's#/usr/libexec/ibus-engine-viettelex#/usr/lib/ibus/ibus-engine-viettelex#' \
    usr/share/ibus/component/viettelex.xml

  # One-click updater (apt/dpkg + polkit) does not apply to pacman: drop it. The settings
  # app then says to update the way it was installed (pacman/AUR helper).
  rm -rf usr/libexec usr/share/polkit-1

  # Debian-only metadata.
  rm -rf usr/share/lintian
  if [ -d usr/share/doc ]; then
    find usr/share/doc -name 'changelog.Debian.gz' -delete
  fi
  install -Dm644 usr/share/doc/viettelex-settings/copyright \
    "usr/share/licenses/${pkgname}/copyright"
}
