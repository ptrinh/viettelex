/* Input-method menu + Accessibility alert */
"Status: OK" = "Tình trạng: OK";
"Status: Permission needed" = "Tình trạng: Thiếu quyền";
"System Settings…" = "Cài đặt hệ thống…";
"Opens Keyboard settings — set automatic input-source switching per app / document there." = "Mở mục Bàn phím trong Cài đặt hệ thống. Tại đây, bạn có thể bật tính năng tự đổi bộ gõ theo ứng dụng hoặc tài liệu.";
"Settings…" = "Cài đặt…";
"{PANE} permission needed" = "Cần quyền {PANE}";
"VietTelex needs Accessibility to type Vietnamese in Terminal/iTerm and browsers.\n\nOpen System Settings → Privacy & Security → Accessibility and enable VietTelex (if it’s already there, untick then tick it again)." = "Để gõ tiếng Việt trong Terminal, iTerm và một số trình duyệt mà không bị gạch chân, VietTelex cần quyền Trợ năng.\n\nMở Cài đặt hệ thống → Quyền riêng tư & Bảo mật → Trợ năng rồi bật VietTelex. Nếu VietTelex đã có trong danh sách, hãy tắt rồi bật lại.";
/* macOS 27 đổi tên mục quyền (PrivacyPane): tên lấy nguyên văn từ chuỗi hệ thống. */
"Accessibility" = "Trợ năng";
"Device Control and Data Access" = "Điều khiển thiết bị và truy cập dữ liệu";
"Permission alert body (macOS 27)" = "Để gõ tiếng Việt trong Terminal, iTerm và một số trình duyệt mà không bị gạch chân, VietTelex cần quyền {PANE}.\n\nMở Cài đặt hệ thống → Quyền riêng tư & Bảo mật → {PANE} rồi bật VietTelex. Nếu đã bật mà VietTelex vẫn báo chưa có quyền, hãy chọn VietTelex, bấm − để xoá rồi bấm + để thêm lại (từ ~/Library/Input Methods).";
"Open Settings" = "Mở Cài đặt";
"Close" = "Đóng";

/* Experimental tab (Thử Nghiệm) */
"VNI typing (experimental)" = "Gõ kiểu VNI (thử nghiệm)";
"Unknown apps use the safe channel (tap/marked)" = "Dùng cách gõ an toàn cho ứng dụng chưa nhận diện";
"Apps without a rule type via backspace-retype (or underlined composition without {PANE} permission) instead of trying direct insertion and guessing. Turn off to restore the old probe-and-learn behavior." = "Với ứng dụng chưa có cách gõ phù hợp, VietTelex sẽ gõ lại phím (Backspace rồi nhập lại) thay vì tự đoán. Nếu chưa cấp quyền {PANE}, chữ có thể được gạch chân khi đang gõ. Tắt mục này để quay lại cách tự dò như trước.";
"Type diacritics with digits instead of Telex letters: 1-5 = sắc/huyền/hỏi/ngã/nặng, 6 = â/ê/ô, 7 = ơ/ư, 8 = ă, 9 = đ, 0 = clear tone. Letters stay literal. Keep Live spell-check on so numbers like “mp3” aren’t turned into tones." = "Gõ dấu bằng số thay cho chữ Telex: 1–5 = sắc/huyền/hỏi/ngã/nặng, 6 = â/ê/ô, 7 = ơ/ư, 8 = ă, 9 = đ, 0 = bỏ dấu. Chữ cái vẫn giữ nguyên. Hãy bật “Kiểm tra chính tả khi gõ” để các chuỗi như “mp3” không bị hiểu nhầm thành dấu.";
"Context-based decision" = "Quyết định theo ngữ cảnh";
"After an English word, an ambiguous next word whose keys spell an English word is kept English instead of Vietnamese — “he is” → “he is”, not “he í”. After a Vietnamese or unclear word it stays Vietnamese — “sao í”." = "Sau một từ tiếng Anh, nếu từ tiếp theo có thể được hiểu theo cả hai cách, VietTelex sẽ ưu tiên tiếng Anh (“he is” giữ nguyên, không thành “he í”). Sau từ tiếng Việt hoặc khi chưa rõ, VietTelex ưu tiên tiếng Việt (“sao í”).";
"Fix earlier words (experimental)" = "Tự sửa từ phía trước (thử nghiệm)";
"As you keep typing an English sentence, words that just got Vietnamese tones by mistake are fixed (e.g. “Hí cả í very fast” → “His car is very fast”)." = "Khi bạn gõ tiếp một câu tiếng Anh, tự sửa các từ vừa bị bỏ dấu nhầm (vd. “Hí cả í very fast” → “His car is very fast”).";
"Safety" = "An toàn";
"Cascade circuit breaker" = "Tự ngắt khi có lỗi";
"Keep this ON. Stops the terminal tap if it ever floods the keyboard with synthetic events, so a bug can’t freeze typing." = "Nên bật mục này. Nếu bộ gõ gửi quá nhiều phím giả lập, VietTelex sẽ tự dừng để bàn phím không bị treo.";
"Diagnostics" = "Chẩn đoán";
"Record debug log" = "Ghi nhật ký gỡ lỗi";
"Records tap health events in memory (never the text you type). Turn it on, reproduce the problem, then Copy debug log and paste it into your report — or save it as a file." = "Khi bật, VietTelex chỉ lưu tạm trong bộ nhớ trạng thái hoạt động của cơ chế Tap, không lưu nội dung bạn gõ. Hãy làm lại thao tác gây lỗi, rồi chọn Chép nhật ký gỡ lỗi để gửi kèm báo lỗi hoặc Lưu nhật ký gỡ lỗi… để lưu thành tệp.";
"Copy debug log" = "Chép nhật ký gỡ lỗi";
"Save debug log…" = "Lưu nhật ký gỡ lỗi…";
"Clear" = "Xoá";
"Copied — paste it into your bug report." = "Đã sao chép. Bạn có thể dán nhật ký vào báo lỗi.";
"Saved to %@" = "Đã lưu vào %@";
"Couldn’t save the file." = "Không lưu được tệp.";

